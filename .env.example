# ローカル開発・本番環境での環境変数設定例
# このファイルをコピーして .env として使用してください
# 注意: .env ファイルは .gitignore に含まれているため、Git にコミットされません

# Flask環境設定
# ローカル開発ではdevelopment、公開時はproductionに変更してください
FLASK_ENV=development

# セキュリティキー（ランダムな文字列を生成してください）
# 例: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-very-secure-secret-key-here-please-change-this

# デモ用管理者アカウントを有効にする場合のパスワード
# ENABLE_DEMO_ADMIN=true のときだけ必要。強力なパスワードを設定してください
ADMIN_PASSWORD=your-secure-admin-password-here

# 本番環境で必要な場合だけ明示的に有効化してください
# ENABLE_RANKING=false
# ENABLE_DEMO_ADMIN=false

# ポート番号（オプション、デフォルト: 5000）
PORT=5000

# WSGIサーバーからimportしたときのDB初期化を無効化する場合のみ1に設定
# SKIP_DB_INIT=1

# データベースファイルのパス（オプション、デフォルト: grades.db）
# DATABASE_PATH=grades.db

# ログレベル（オプション、デフォルト: INFO）
# LOG_LEVEL=INFO
